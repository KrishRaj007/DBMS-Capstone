{
  "name": "music-analytics-backend",
  "version": "1.0.0",
  "description": "Music Recommendation & Listening Analytics System — Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node db/seed.js",
    "init-db": "node db/init.js",
    "migrate": "node db/migrate.js",
    "pipeline": "python ../pipeline/run.py",
    "pipeline:verify": "python ../pipeline/run.py --verify-only",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
